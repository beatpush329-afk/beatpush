# ============================================
# BEATSPUSH FRONTEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this to .env.local for local development
# For Netlify, add these in: Site Settings → Environment Variables

# ============================================
# API BACKEND URL
# ============================================
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# After deploying backend to Render:
# NEXT_PUBLIC_API_URL=https://beatpush-backend.onrender.com

# Production:
# NEXT_PUBLIC_API_URL=https://api.beatpush.com

# ============================================
# WEBSOCKET URL (For real-time features)
# ============================================
# Local:
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Render (after deployment):
# NEXT_PUBLIC_WS_URL=wss://beatpush-backend.onrender.com

# ============================================
# APPLICATION INFO
# ============================================
NEXT_PUBLIC_APP_NAME=BeatsPush
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# After Netlify deployment:
# NEXT_PUBLIC_APP_URL=https://your-app.netlify.app

# ============================================
# PAYMENT - PAYSTACK (Africa, Europe, US)
# ============================================
# Get FREE test keys from: https://dashboard.paystack.com/#/settings/developers

# PAYSTACK - Frontend Keys (Public/Publishable)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_1234567890abcdefghijklmnopqrstuvwxyz

# Payment Provider (PAYSTACK ONLY)
NEXT_PUBLIC_PAYMENT_PROVIDER=paystack

# Supported Currencies
# NGN (Naira), USD, GBP, EUR, ZAR, GHS, KES
NEXT_PUBLIC_DEFAULT_CURRENCY=NGN

# ============================================
# CLOUDFLARE TURNSTILE (Bot Protection)
# ============================================
# Get free at https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ

# For testing:
NEXT_PUBLIC_TURNSTILE_ENABLED=false

# ============================================
# GOOGLE ANALYTICS (Optional)
# ============================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# GOOGLE OAUTH (Optional - Social Login)
# ============================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================
# FACEBOOK OAUTH (Optional)
# ============================================
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# ============================================
# FEATURES FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=false
NEXT_PUBLIC_ENABLE_LIVE_STREAMING=true
NEXT_PUBLIC_ENABLE_MESSAGING=true
NEXT_PUBLIC_ENABLE_FAN_CLUBS=true

# ============================================
# MEDIA / CDN
# ============================================
# Cloudflare R2 public URL for uploaded content
NEXT_PUBLIC_MEDIA_URL=https://uploads.beatpush.com

# ============================================
# SENTRY ERROR TRACKING (Optional)
# ============================================
NEXT_PUBLIC_SENTRY_DSN=https://1234567890abcdefghijklmnopqrstuvwx@sentry.io/1234567
NEXT_PUBLIC_SENTRY_ENABLED=false

# ============================================
# ENVIRONMENT
# ============================================
NEXT_PUBLIC_ENVIRONMENT=development
# Options: development, staging, production

# ============================================
# DEBUG & LOGGING
# ============================================
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_LOG_LEVEL=info
# Options: debug, info, warn, error
