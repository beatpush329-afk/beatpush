# ============================================
# BEATSPUSH BACKEND - TESTING ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and update with your actual values
# For testing, you can use these placeholder values

# ============================================
# CORE SECURITY
# ============================================
SECRET_KEY=test_secret_key_replace_in_production_min_32_chars_long_12345678
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=development
DEBUG=True
APP_NAME=BeatsPush
APP_VERSION=1.0.0

# ============================================
# DATABASE - Use SQLite for local testing
# ============================================
# For local testing (SQLite):
DATABASE_URL=sqlite:///./beatspush_test.db

# For Render (PostgreSQL) - uncomment and use this format:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================
# REDIS - Optional for testing
# ============================================
# For local testing without Redis:
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# For Render (Redis) - will be auto-configured

# ============================================
# CORS - Frontend URLs
# ============================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# For production (update after Netlify deployment):
# FRONTEND_URL=https://your-app.netlify.app
# ALLOWED_ORIGINS=https://your-app.netlify.app,https://beatpush.com

# ============================================
# EMAIL (Gmail SMTP) - FOR TESTING
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# To get Gmail App Password:
# 1. Go to Google Account Settings
# 2. Security → 2-Step Verification (enable it)
# 3. Security → App passwords
# 4. Generate password for "Mail"
# 5. Copy the 16-character password here

SMTP_FROM_EMAIL=noreply@beatspush.com
SMTP_FROM_NAME=BeatsPush

# ============================================
# PAYMENT - PAYSTACK ONLY (Africa, Europe, US)
# ============================================
# Paystack supports: NGN (Naira), USD, GBP, EUR, ZAR, GHS, KES, and more!
# Sign up FREE at: https://dashboard.paystack.com/signup

# PAYSTACK - Test Keys (Get from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_1234567890abcdefghijklmnopqrstuvwxyz
PAYSTACK_PUBLIC_KEY=pk_test_1234567890abcdefghijklmnopqrstuvwxyz

# Payment Provider (PAYSTACK ONLY)
PAYMENT_PROVIDER=paystack

# Supported Currencies (Paystack handles all of these):
# NGN - Nigerian Naira (Primary for Africa)
# USD - US Dollar
# GBP - British Pound
# EUR - Euro
# ZAR - South African Rand
# GHS - Ghanaian Cedi
# KES - Kenyan Shilling
DEFAULT_CURRENCY=NGN

# ============================================
# CLOUD STORAGE - Cloudflare R2 (AWS S3 Compatible)
# ============================================
# Sign up free at https://dash.cloudflare.com/
# Get 10GB free storage

AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=beatpush-uploads
R2_PUBLIC_URL=https://uploads.beatpush.com

# For local testing, can use local file storage:
USE_LOCAL_STORAGE=True
LOCAL_UPLOAD_DIR=./uploads

# ============================================
# AI / OPENAI - Optional (Can skip for testing)
# ============================================
# Get free credits at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-1234567890abcdefghijklmnopqrstuvwxyz
OPENAI_MODEL=gpt-3.5-turbo
AI_ENABLED=False

# Alternative: Use HuggingFace (Free)
HUGGINGFACE_API_KEY=hf_1234567890abcdefghijklmnopqrstuvwxyz
USE_HUGGINGFACE=True

# ============================================
# SMS / WHATSAPP - Optional (Can skip for testing)
# ============================================
# Twilio - Get free trial at https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=AC1234567890abcdefghijklmnopqrstuvwx
TWILIO_AUTH_TOKEN=1234567890abcdefghijklmnopqrstuvwx
TWILIO_PHONE_NUMBER=+1234567890
SMS_ENABLED=False

# WhatsApp Business API (Optional)
WHATSAPP_TOKEN=your_whatsapp_business_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_ENABLED=False

# ============================================
# CLOUDFLARE TURNSTILE (Bot Protection)
# ============================================
# Get free at https://dash.cloudflare.com/
TURNSTILE_SECRET_KEY=0x1234567890abcdefghijklmnopqrstuvwxyz
TURNSTILE_SITE_KEY=0x1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ

# For testing, you can disable it:
TURNSTILE_ENABLED=False

# ============================================
# ANALYTICS & MONITORING
# ============================================
# Google Analytics (Optional)
GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry Error Tracking (Optional)
SENTRY_DSN=https://1234567890abcdefghijklmnopqrstuvwx@sentry.io/1234567

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# FILE UPLOAD LIMITS
# ============================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_AUDIO_FORMATS=mp3,wav,flac,m4a,aac
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,gif,webp

# ============================================
# WEBSOCKET (Real-time features)
# ============================================
WS_ENABLED=True
WS_HEARTBEAT_INTERVAL=30

# ============================================
# CELERY / BACKGROUND JOBS (Optional)
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_ENABLED=False

# ============================================
# TESTING & DEVELOPMENT
# ============================================
ENABLE_API_DOCS=True
ENABLE_ADMIN_PANEL=True
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# SOCIAL AUTH (Optional - OAuth)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret

SOCIAL_AUTH_ENABLED=False

# ============================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ============================================
# 1. Generate new SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 2. Set DEBUG=False
# 3. Use PostgreSQL for DATABASE_URL
# 4. Enable Redis (REDIS_ENABLED=True)
# 5. Update ALLOWED_ORIGINS with your domain
# 6. Use real payment keys (remove _test_ from keys)
# 7. Enable rate limiting and security features
# 8. Set up proper logging and monitoring
